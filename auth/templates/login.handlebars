<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
  <meta name="referrer" content="no-referrer">
  <title>Sign in | Virtual Labs</title>
  <script src="{{prefix}}js/vlabs-auth-login.js" defer></script>
</head>

<body class="p-0 container-fluid vlabs-page d-flex flex-column justify-content-between">
  {{> header}}

  <main class="vl-auth-page flex-fill d-flex flex-column align-items-center px-3">
    <div class="vl-card">
      <div class="vl-card-head">
        <h1 id="title">Sign in to Virtual Labs</h1>
        <p class="vl-sub">to continue to <strong>{{site_name}}</strong></p>
      </div>

      <div id="alert" class="alert" role="alert" hidden></div>

      <!-- Loading / redirecting -->
      <section data-view="busy" class="text-center py-4">
        <span class="spinner-border text-info" role="status" aria-hidden="true"></span>
        <p class="mt-3 mb-0" id="busy-text">One moment…</p>
      </section>

      <!-- 1. Email first -->
      <section data-view="email" hidden>
        <form id="email-form" novalidate>
          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" class="form-control" id="email" name="email" autocomplete="email" inputmode="email" required>
            <div class="invalid-feedback"></div>
            <small class="form-text text-muted">Use the same address to sign in or to create an account.</small>
          </div>
          <button type="submit" class="v-button btn-block">Next</button>
        </form>

        <div id="providers" hidden>
          <div class="vl-divider"><span>or</span></div>
          <div id="provider-buttons" class="d-flex flex-column"></div>
        </div>
      </section>

      <!-- 2a. Existing password account -->
      <section data-view="password" hidden>
        <p class="vl-email-chip"><i class="fa fa-user-circle-o" aria-hidden="true"></i> <span data-email></span>
          <button type="button" class="btn btn-link btn-sm p-0 ml-auto" data-action="change-email">Change</button></p>
        <form id="password-form" novalidate>
          <input type="email" name="username" autocomplete="username" data-email-value hidden>
          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required>
              <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" data-toggle-password="password" aria-label="Show password"><i class="fa fa-eye"></i></button>
              </div>
              <div class="invalid-feedback"></div>
            </div>
          </div>
          <button type="submit" class="v-button btn-block">Sign in</button>
        </form>
        <p class="text-center mt-3 mb-0"><button type="button" class="btn btn-link" data-action="forgot">Forgot password?</button></p>
      </section>

      <!-- 2b. Redirect to the provider the user signed up with, or a college SSO -->
      <section data-view="redirect" hidden>
        <p class="vl-email-chip"><i class="fa fa-user-circle-o" aria-hidden="true"></i> <span data-email></span>
          <button type="button" class="btn btn-link btn-sm p-0 ml-auto" data-action="change-email">Change</button></p>
        <p id="redirect-text"></p>
        <a id="redirect-link" class="v-button btn-block text-center" href="#"></a>
        <p class="text-center mt-3 mb-0" id="redirect-password" hidden>
          <button type="button" class="btn btn-link" data-action="use-password">Sign in with your password instead</button>
        </p>
      </section>

      <!-- 3. New account: Turnstile, then a verification email -->
      <section data-view="verify" hidden>
        <p class="vl-email-chip"><i class="fa fa-envelope-o" aria-hidden="true"></i> <span data-email></span>
          <button type="button" class="btn btn-link btn-sm p-0 ml-auto" data-action="change-email">Change</button></p>
        <p>There's no Virtual Labs account for this address yet. We'll email you a link to confirm it's yours, then you can choose a password.</p>
        <form id="verify-form" novalidate>
          <div class="vl-turnstile" id="turnstile-signup"></div>
          <button type="submit" class="v-button btn-block">Email me a sign-up link</button>
        </form>
      </section>

      <section data-view="verify-sent" hidden>
        <div class="vl-big-icon"><i class="fa fa-envelope-open-o" aria-hidden="true"></i></div>
        <h2 class="vl-view-title">Check your email</h2>
        <p>We sent a sign-up link to <strong data-email></strong>. It expires in <span id="verify-ttl">60 minutes</span>.</p>
        <p class="text-muted small">Can't find it? Check your spam folder, or <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="resend">send another link</button>.</p>
      </section>

      <!-- 4. Arrived from the email link: choose a name and password -->
      <section data-view="signup" hidden>
        <p class="vl-email-chip"><i class="fa fa-check-circle text-success" aria-hidden="true"></i> <span data-email></span></p>
        <form id="signup-form" novalidate>
          <input type="email" name="username" autocomplete="username" data-email-value hidden>
          <div class="form-group">
            <label for="signup-name">Full name</label>
            <input type="text" class="form-control" id="signup-name" name="name" autocomplete="name" maxlength="100" required>
            <div class="invalid-feedback"></div>
          </div>
          <div class="form-group">
            <label for="signup-password">Choose a password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="signup-password" name="password" autocomplete="new-password" required>
              <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" data-toggle-password="signup-password" aria-label="Show password"><i class="fa fa-eye"></i></button>
              </div>
              <div class="invalid-feedback"></div>
            </div>
            <small class="form-text text-muted" data-password-hint></small>
          </div>
          <button type="submit" class="v-button btn-block">Create account</button>
        </form>
      </section>

      <!-- Forgot password -->
      <section data-view="forgot" hidden>
        <p>Enter your email address and we'll send you a link to set a new password.</p>
        <form id="forgot-form" novalidate>
          <div class="form-group">
            <label for="forgot-email">Email address</label>
            <input type="email" class="form-control" id="forgot-email" name="email" autocomplete="email" required>
            <div class="invalid-feedback"></div>
          </div>
          <div class="vl-turnstile" id="turnstile-reset"></div>
          <button type="submit" class="v-button btn-block">Send reset link</button>
        </form>
        <p class="text-center mt-3 mb-0"><button type="button" class="btn btn-link" data-action="back">Back to sign in</button></p>
      </section>

      <section data-view="forgot-sent" hidden>
        <div class="vl-big-icon"><i class="fa fa-envelope-open-o" aria-hidden="true"></i></div>
        <h2 class="vl-view-title">Check your email</h2>
        <p>If there's an account for <strong data-email></strong>, we've sent it a link to set a new password. The link expires in <span id="reset-ttl">30 minutes</span>.</p>
        <p class="text-center mb-0"><button type="button" class="btn btn-link" data-action="back">Back to sign in</button></p>
      </section>

      <!-- Arrived from a reset link -->
      <section data-view="reset" hidden>
        <form id="reset-form" novalidate>
          <div class="form-group">
            <label for="reset-password">New password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="reset-password" name="password" autocomplete="new-password" required>
              <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" data-toggle-password="reset-password" aria-label="Show password"><i class="fa fa-eye"></i></button>
              </div>
              <div class="invalid-feedback"></div>
            </div>
            <small class="form-text text-muted" data-password-hint></small>
          </div>
          <button type="submit" class="v-button btn-block">Set password and sign in</button>
        </form>
        <p class="small text-muted mt-3 mb-0">This signs you out on every other device.</p>
      </section>

      <!-- A used or expired email link -->
      <section data-view="link-invalid" hidden>
        <div class="vl-big-icon text-warning"><i class="fa fa-chain-broken" aria-hidden="true"></i></div>
        <h2 class="vl-view-title">This link has expired</h2>
        <p>Links from our emails work once and only for a limited time. Start again to get a new one.</p>
        <button type="button" class="v-button btn-block" data-action="back">Start again</button>
      </section>
    </div>

    <p class="vl-fineprint">One Virtual Labs account works on every lab and experiment.</p>
  </main>

  {{> footer}}
</body>
</html>
